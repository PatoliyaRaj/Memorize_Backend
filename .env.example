# Example env for backend (do NOT commit secrets to VCS)
JWT_SECRET=your_jwt_secret_here
# Local Postgres (development)
POSTGRES_URL=postgresql://user:password@localhost:5432/memorize

# Supabase (production)
# Optional: direct Postgres URL for Supabase (use in server-side PG access)
SUPABASE_DB_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
# Use service_role for server-side actions; keep this secret
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Control which DB to prefer: local | supabase | fallback
DB_STRATEGY=fallback

# Optional SSL tuning for Supabase PG connections
# DB_SSL=require

# Pooling and timeouts
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MILLIS=30000
PG_CONNECTION_TIMEOUT_MILLIS=2000

PORT=3000


# Image upload configration via IMAGEKIT.IO
IMAGEKIT_PUBLIC_KEY=your_public_key_here
IMAGEKIT_PRIVATE_KEY=your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ==========================================
# TRANSACTIONAL EMAIL SETTINGS (RESEND)
# ==========================================
# Generate this key in the Resend developer console (https://resend.com)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwx

# The outbound mailer address. 
# Note: In development/sandbox mode, Resend requires this to be: onboarding@resend.dev
# Once your domain is verified on Resend, change this to: e.g. NeuroLearn <noreply@yourdomain.com>
EMAIL_FROM=onboarding@resend.dev

# ==========================================
# WEB PUSH CRYPTOGRAPHIC KEYS (VAPID)
# ==========================================
# Generate these keys by running: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@yourdomain.com
VAPID_PUBLIC_KEY=BM_q4uPz_some_long_public_key_from_command...
VAPID_PRIVATE_KEY=your_vapid_private_key_from_command...