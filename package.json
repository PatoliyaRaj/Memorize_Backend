    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "fs": "^0.0.1-security",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "path": "^0.12.7",
    "postgres": "^3.4.9",
    "resend": "^6.12.4",
